{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pyrion approved normalized document v1.0 / v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "projectId",
    "documentNumber",
    "title",
    "revision",
    "language",
    "blocks",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "$ref": "#/definitions/metadata"
    },
    "documentNumber": {
      "$ref": "#/definitions/metadata"
    },
    "title": {
      "$ref": "#/definitions/metadata"
    },
    "revision": {
      "$ref": "#/definitions/metadata"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fa",
        "mixed"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/block"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approvedBy",
        "approvedAt",
        "draftId",
        "modelId"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        "approvedBy": {
          "$ref": "#/definitions/metadata"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "draftId": {
          "type": "string",
          "format": "uuid"
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "extractionWarnings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReference",
        "type",
        "headingLevel",
        "text",
        "rows",
        "formatting"
      ],
      "properties": {
        "sourceReference": {
          "$ref": "#/definitions/reference"
        },
        "type": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "list",
            "table"
          ]
        },
        "headingLevel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string"
        },
        "rows": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cells"
            ],
            "properties": {
              "cells": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "sourceReference"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "sourceReference": {
                      "$ref": "#/definitions/reference"
                    }
                  }
                }
              }
            }
          }
        },
        "formatting": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "style",
            "bold",
            "fontSizePoints",
            "numberingId",
            "listLevel"
          ],
          "properties": {
            "style": {
              "type": [
                "string",
                "null"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "fontSizePoints": {
              "type": [
                "number",
                "null"
              ]
            },
            "numberingId": {
              "type": [
                "string",
                "null"
              ]
            },
            "listLevel": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
