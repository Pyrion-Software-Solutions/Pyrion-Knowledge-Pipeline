{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pyrion analysis proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issues",
    "blocks"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceReference",
              "suggestedType",
              "suggestedHeadingLevel",
              "reason"
            ],
            "properties": {
              "sourceReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "suggestedType": {
                "type": "string",
                "enum": [
                  "heading"
                ]
              },
              "suggestedHeadingLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "One concise sentence explaining the structural issue."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceReference",
              "suggestedType",
              "suggestedHeadingLevel",
              "reason"
            ],
            "properties": {
              "sourceReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "suggestedType": {
                "type": "string",
                "enum": [
                  "paragraph",
                  "list",
                  "table"
                ]
              },
              "suggestedHeadingLevel": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "One concise sentence explaining the structural issue."
              }
            }
          }
        ]
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceReference",
              "type",
              "headingLevel"
            ],
            "properties": {
              "sourceReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "type": {
                "type": "string",
                "enum": [
                  "heading"
                ]
              },
              "headingLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceReference",
              "type",
              "headingLevel"
            ],
            "properties": {
              "sourceReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "type": {
                "type": "string",
                "enum": [
                  "paragraph",
                  "list",
                  "table"
                ]
              },
              "headingLevel": {
                "type": "null"
              }
            }
          }
        ]
      }
    }
  }
}
